# HTTP
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# PostgreSQL
DATABASE_URL=postgres://memory:memory@localhost:5432/memorybutton?sslmode=disable
DB_MAX_CONNS=10

# Single-user auth (минимальная авторизация для одной семьи)
AUTH_USERNAME=family
AUTH_PASSWORD=change-me
# AUTH_PASSWORD_HASH=$2a$10$...  # альтернатива паролю в открытом виде
# AUTH_STATIC_TOKEN=long-random-token-for-debug  # опциональный bearer для отладки клиента

# JWT (HS256)
JWT_SECRET=replace-with-long-random-secret
JWT_TTL=24h
JWT_ISSUER=memory-button

# S3 / MinIO
S3_ENDPOINT=localhost:9000
S3_REGION=us-east-1
S3_BUCKET=memory-button
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
# S3_PUBLIC_URL=https://cdn.example.com  # опционально, если бакет доступен публично

# Hugging Face / AI
# AI_PROVIDER: "stub" (локально, без ключей) или "hf"
AI_PROVIDER=stub
AI_FALLBACK_TO_STUB=true
# HF_TOKEN=hf_xxx
HF_BASE_URL=https://router.huggingface.co/hf-inference/models
HF_CHAT_MODEL=mistralai/Mistral-7B-Instruct-v0.3
HF_ASR_MODEL=openai/whisper-large-v3
HF_TTS_MODEL=microsoft/speecht5_tts
HF_TIMEOUT=90s
# HF_INTERVIEWER_MODEL=...
# HF_EXTRACTOR_MODEL=...

# Воркер / постобработка
WORKER_ENABLED=true
WORKER_POLL_INTERVAL=2s
# PROCESSING_SYNC=true  # обрабатывать черновик синхронно в /complete (удобно для MVP)
